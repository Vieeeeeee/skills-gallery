{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "skills-gallery-sync",
  "main": "sync-worker.js",
  "compatibility_date": "2026-09-01",
  "kv_namespaces": [
    {
      "binding": "SKILLS_KV",
      "id": "skills_data_kv"
    }
  ],
  "vars": {
    "ADMIN_PASSCODE": "admin888"
  }
}
